model NG_PBK_PFOA()

# PARAMETERS

    ## Time parameters
   
    Age := 1/365                               # Age [years]
   
   
    ## PHYSIOLOGICAL PARAMETERS
   
        ### Body size over lifetime 
       
        BW_M       := (3.938425 + 0.7518199*Age*12 - 0.02023793*(Age*12)^2 + 0.0002921682*(Age*12)^3 - 2.06762e-06*(Age*12)^4 + 8.469e-09*(Age*12)^5 - 2.188427e-11*(Age*12)^6 + 3.699776e-14*(Age*12)^7 - 4.099077e-17*(Age*12)^8 + 2.874804e-20*(Age*12)^9 - 1.159732e-23*(Age*12)^10 + 2.052602e-27*(Age*12)^11) # [kg]
        BH_M       := (5.869e+01) + (1.265e+01)*Age - (4.665e-01)*Age^2 + (7.198e-03)*Age^3 - (3.224e-05)*Age^4 - (2.512e-07)*Age^5 + (2.071e-09)*Age^6 # [cm2]


        ### Hematocrit over lifetime
        
        Param1_M    = 33.455469                    # [-]
        Param2_M    = 53.206039                    # [-]
        Param3_M    = 8.277945                     # [-]
        Param4_M    = 40.492556                    # [-]
        Param5_M    = 46.899695                    # [-]
      
        b1_M        = (Param4_M - Param1_M -(Param2_M - Param1_M) * exp(-Param3_M))/5 # [-]
        a1_M        = Param4_M - 6*b1_M            # [-]
        b2_M        = (Param5_M - Param4_M)/5      # [-]
        a2_M        = Param4_M - 15*b2_M           # [-]
      
        Hct_ven    := piecewise(Param5_M*0.01, Age < 1, (Param1_M +(Param2_M-Param1_M)*exp(-Param3_M*Age))*0.01, Age < 6, (a1_M + b1_M*Age)*0.01, Age < 15, Param4_M*0.01, Age < 20, (a2_M + b2_M*Age)*0.01) # [-]
        Hct_M      := Hct_ven*0.91                 # [-]
      
        ### Plasma flow over lifetime
        
        QC         := piecewise((-0.000895*Age^2 + 0.0607*Age + 5.54)*(1-Hct_M)*60*24, Age < 33.37, (6.642 + (0.6 - 6.642)*exp(-0.1323*Age))*(1-Hct_M)*60*24) # [L/day]


        ### Glomerular filtration over lifetime
        
        SCr_M       = 0.90                                                                # [-]
        BSA_M       = exp(-3.75 + 0.42*log(BH_M)+0.52*log(BW_M))  # [cm^2]
        GFR_M_base  = (107.3 * 1.44*(BSA_M)/1.73) / (SCr_M/SCr_M) # [-]
        GFR        := piecewise(GFR_M_base * 0.988^(Age - 40), Age <= 40, GFR_M_base) # [L/day]
        
        
        ### Serum albumin concentration over lifetime 
        
        SAlb_M     := 3.9330e+01 + (5.8156e-01*Age) - (1.9072e-02*(Age^2)) + (2.3220e-04*(Age^3)) - (1.0313e-06*(Age^4)) # [mg/ml]


        ### Constants, fractional volume of organs over lifetime
        
        V_adrenalFraction_M            := 0.0002 + (0.00171 - 0.0002)*exp(-2.02*Age)                        # [-]
        V_boneFraction_M               := (0.313 + (0.506 - 0.313)*exp(-0.0907*Age))*0.095                  # [-]
        V_bonenonperfusedFraction_M    := 0.095 -   V_boneFraction_M                                        # [-]
        V_brainFraction_M              := (1.450 + (0.353 - 1.450) * exp (-0.440*Age))/BW_M                 # [-]
        V_breastFraction_M             := 3.42E-4*1/(1 + exp(-1.42*Age + 20.1))                             # [-]
        V_heartFraction_M              := 0.0045                                                            # [-]
        V_marrowFraction_M             := 0.05 + (0.0138 - 0.05)*exp(-0.112*Age)                            # [-]
        MuscleAtrophy_M                := piecewise(-0.0001264*Age^2 + 0.006131*Age + 0.926, Age < 24.3, 1) # [-]
        V_muscleFraction_M             := (0.3973 + (0.201 - 0.3973)*exp(-0.141*Age)) * MuscleAtrophy_M     # [-]
        V_reproFraction_M              := piecewise(0.0008, Age < 20.01, -1.5156E-07*Age^3 + 9.3351E-06*Age^2 - 1.1177E-04*Age + 4.7966E-04) # [-]
        V_pancreasFraction_M            = 0.00192                                                           # [-]
        V_skinFraction_M               := piecewise(0.0452, Age < 20.01, -1.1706E-05*Age^3 + 5.4130E-04*Age^2 - 6.1966E-03*Age + 4.6231E-02) # [-]
        V_spleenFraction_M              = 0.0021                                                            # [-]
        V_thyroidFraction_M             = 0.000274                                                          # [-]
        V_urinarytractFraction_M        = 0.00104                                                           # [-]
        V_kidneyFraction_M             := 0.0042 + (0.00767 - 0.0042)*exp(-0.206*Age)                       # [-]
        V_lungFraction_M                = 0.0068                                                            # [-]
        V_gutFraction_M                := piecewise(0.0140, Age < 16, -0.000082562*Age^2 + 0.0013523*Age + 0.01293) # [-]
        V_stomachFraction_M             = 0.0021                                                            # [-]
        V_liverFraction_M              := 0.0247 + (0.0409 - 0.0247)*exp(-0.218*Age)                        # [-]
        V_bloodFraction_M              := piecewise(0.0761 + (0.0289 - 0.0761)*exp(-0.592*Age), Age < 1, (-0.0273*Age + 0.0771))  # [-]
        V_adiposeFraction_M            := 0.96 - V_adrenalFraction_M - V_boneFraction_M - V_bonenonperfusedFraction_M - V_brainFraction_M - V_breastFraction_M - V_heartFraction_M - V_marrowFraction_M - V_muscleFraction_M - V_reproFraction_M - V_pancreasFraction_M - V_skinFraction_M - V_spleenFraction_M - V_thyroidFraction_M - V_urinarytractFraction_M - V_kidneyFraction_M - V_lungFraction_M - V_gutFraction_M - V_stomachFraction_M - V_liverFraction_M - V_bloodFraction_M # [-]
        
        
        ### Constants, assumed to be the same over lifetime #
        
        Length   = 280                                    # [cm] length of the small intestine, (adult of 70kg) Willmann2004 doi: 10.1021/jm030999b
        Radius   = 1.75                                   # [cm] radius of the small intestine, (adult of 70kg mean value) Willmann2004 doi: 10.1021/jm030999b
        VILc     = pi*Length*(Radius^2)/1000/70           # [-} volume of the intestinal lumen in L, body weight corrected, cm3/1000 #Value is the same as Punt et al. 2021 https://dx.doi.org/10.1021/acs.chemrestox.0c00307; deriving the constant by dividing by the BW_M of an adult of 70kg (Willmann2004 doi: 10.1021/jm030999b)
        SA_SIc   = 2*pi*Radius*Length*25/70               # [-] small intestinal surface area, body weight corrected
        VL_icc   = 0.573                                  # [-] fractional volume of liver intracellular space
        VL_ecc   = 1 - 0.573                              # [-] fractional volume of liver extracellular space
        VPTc     = 0.398                                  # [-] fractional volume of kidney proximal tubule
        VPTTc    = 0.137*(1-Hct_M) + 0.460                # [-] fractional volume of kidney proximal tubule tissue (VPTTc = VPTBc*(1-Hct_M) + VPTCc, where VPTBc = 0.137 and VPTCc = 0.460)
        VPTLc    = 0.403                                  # [-] fractional volume of kidney proximal tubule lumen
        VRKLc    = 0.283                                  # [-] fractional volume of kidney rest of kidney lumen
        VTotc    = 0.94                                   # [-] fractional total body volume 
        QTotc    = 0.96                                   # [-] fractional total blood flow
        QUrc     = 0.022                                  # [-] fractional urine excretion flow, urine flow rate to the bladder 22 mL/kg BW_M/d [ICRP 89 pAge 161]
        QTc      = 0.36                                   # [-] fractional proximal tubuli fluid flow, based on reference values of GFR 120 and QT of 43.2 from Scotcher et al. 2016 https://doi.org/10.1016/j.ejps.2016.03.018 and Pletz
        tco      = 0.14*24                                # [-] bowel residence/transit time in the colon,/d, (24*/h) or 7h willmann2004 doi: 10.1021/jm030999b


        ### Final constants used in the model #
        
        VIc      := V_gutFraction_M                       # [-] 
        VLc      := V_liverFraction_M                     # [-]
        VKc      := V_kidneyFraction_M                    # [-]
        MAc      := piecewise((-0.01129273*Age^2 + 1.11817056*Age + 56.74397436) - (74.16235828-(2*(74.16235828-57.19957758)/(exp(0.63466182*(Age-13.31018000))+exp(0.05457656*(Age-13.31018000))))),Age < 19.00093277, 0 ) # [-]
      
        VAc      := 0.96 - V_adrenalFraction_M - V_boneFraction_M - V_bonenonperfusedFraction_M - V_brainFraction_M - V_breastFraction_M -V_heartFraction_M - V_marrowFraction_M - V_muscleFraction_M - V_reproFraction_M -  V_pancreasFraction_M - V_skinFraction_M - V_spleenFraction_M - V_thyroidFraction_M - V_urinarytractFraction_M - V_kidneyFraction_M - V_lungFraction_M - V_gutFraction_M - V_stomachFraction_M - V_liverFraction_M - V_bloodFraction_M # [-]
        VPc      := V_bloodFraction_M                     # [-]


        ### Fractional plasma flow of organs over lifetime
        
        QIc      := (V_gutFraction_M/0.0140)*0.144        # [-]
        QLc      := (V_liverFraction_M/0.0247)*0.065      # [-]
        QKc      := (V_kidneyFraction_M/0.0042)*0.196     # [-]
        QAc      := (V_adiposeFraction_M/0.20)*0.052      # [-]


        ### Volume of organs 
        
        VIL      := VILc * BW_M                             # [L]
        VI       := VIc * BW_M                              # [L]
        VL       := VLc * BW_M                              # [L]
        VL_ic    := VL_icc * VL                             # [L]
        VL_ec    := VL_ecc * VL                             # [L]
        VK       := VKc * BW_M                              # [L]
        VPT      := VPTc * VK                               # [L]
        VPTT     := VPT * VPTTc                             # [L]
        VPTL     := VPT * VPTLc                             # [L]
        VRKL     := (VK - VPT) * VRKLc                      # [L]
        VRKT     := VK - VPTT - VPTL - VRKL                 # [L]
        VA       := VAc * BW_M/0.9 + MAc/0.9                # [L]
        VP       := VPc * (1-Hct_M) * BW_M                  # [L]
        VTot     := VTotc * BW_M                            # [L]
        VR       := VTot - (VI + VL + VK + VA + VP)         # [L]
  
  
        ### Surface aeria 
        
        SA_SI    := SA_SIc * BW_M                           # [cm^2]
        
        # Plasma flow of organs 
        
        QI       := QIc/QTotc * QC                          # [L/d]
        QL       := QLc/QTotc * QC                          # [L/d]
        QK       := QKc/QTotc * QC                          # [L/d]
        QA       := QAc/QTotc * QC                          # [L/d]
        QR       := QC - (QA + QI + QK + QL)                # [L/d]
        
        ### Proximal tubule fluid flow
        QT       := QTc * GFR                               # [L/d] proximal tubule fluid flow
        QUr      := QUrc * GFR                              # [L/d] urine secretion flow
  
  
     ## PHYSICOCHEMICAL PARAMETERS
   
       MW = 414.07
       
       ### Albumin concentration
       Calb_P    = SAlb_M                                 # [g/L] plasma (see above for values)
       Calb_PTL  = 14.4e-3                                # [g/L] proximal tubule 
       Calb_IL   = 0.007e-3                               # [g/L] intestinal lumen
       Calb_L_ec = 0.0012e-3                              # [g/L] liver extracellular 
      
       ### Albumin ratio, based on the Poulin and Theil 2009, below Table 6
       R_PTL    = Calb_P/Calb_PTL                         # [-] plasma to proximal tubule lumen albumin ratio
       R_L_ec   = Calb_P/Calb_L_ec                        # [-] plasma to liver albumin ratio
       R_IL     = Calb_P/Calb_IL                          # [-] plasma to intestinal lumen albumin ratio
     
     
       ### Distribution coefficients to different matrices 
       logML    = 3.52                                    # [-] 3.52 ± 0.08 from Ebert A., Allendorf F. et al (2020), https://dx.doi.org/10.1021/acs.est.0c00175  (Liposomes composed of POPC (1-palmitoyl-2-oleoyl-glycero-3-phosphocholine))
       logSP    = 1.61                                    # [-] 1.61 ± 0.15 from Allendorf, F., Goss, K.-U. and Ulrich, N. (2021), https://doi.org/10.1002/etc.4954  (Structural proteins from chicken breast fillet (actin & myosin 60-95%), Recovery 95%)
       logALB   = 4.48                                    # [-] Fischer et al 2024 logALB = 4.48±0.04 https://pubs.acs.org/doi/pdf/10.1021/acs.est.3c07415?ref=article_openPDF; 4.33                                  # 4.33 ± 0.05 from Allendorf, F., Goss, K.-U. and Ulrich, N. (2021), https://doi.org/10.1002/etc.4954 (BSA (fatty acid free) Molar ratio compound to BSA < 0.1 72-96h, Recovery 94%))
       logSL    = -1.37                                   # [-] -1.37 ± 0.01 from Allendorf, F., Goss, K.-U. and Ulrich, N. (2021), https://doi.org/10.1002/etc.4954 (Olive oil with a high fraction of unsaturated fatty acids, Recovery 95%)
       logFABP  = 4.3                                     # [-] calculated by Allendorf, F., Goss, K.-U. and Ulrich, N. (2021), https://doi.org/10.1002/etc.4954
       logGLOB  = 2.16                                    # [-] Fischer et al 2024 globulin/water partition coefficient      
     
       k_ML     = 10^logML                                # [Lw/Kg_ML] neutral phospholipids:water partition coefficient
       k_SP     = 10^logSP                                # [Lw/Kg_SP] structural protein:water partition coefficient
       k_ALB    = 10^logALB                               # [Lw/Kg_ALB] albumin:water partition coefficient
       k_SL     = 10^logSL                                # [Lw/Kg_SL] structural lipids:water partition coefficient
       k_FABP   = 10^logFABP                              # [Lw/Kg_FABP] fatty acid-binding protein:water partition coefficient
       k_GLOB   = 10^logGLOB                              # [Lw/Kg_GLOB] globulin/water partition coefficient 

     
       ### Fraction unbound in plasma (equation for calculating fraction unbound in plasma was taken from https://doi.org/10.1021/acs.est.3c07415)
     
       DAlb     = 1.36                                    # [kg/L] density of albumin
       D_ALB    = k_ALB*DAlb                              # [-] distribution coefficient
       FV_Alb   = SAlb_M*10^-3                            # [-] fractional volume of albumin in serum
       
       DGlob    = 1.20                                    # [kg/L] density of globulin
       D_Glob   = k_GLOB*DGlob                            # [-] distribution coefficient
       FV_Glob  = 0.031                                   # [-] fractional volume of globulin in serum
       
       FV_W     = 1 - FV_Alb - FV_Glob                    # [-] serum mass balance
     
       fup      = 1/(1 + (D_ALB*(FV_Alb/FV_W)) + (D_Glob*(FV_Glob/FV_W)))    # [-] fraction unbound in plasma
     
     
       ### Fraction unbound in tissues
     
       fu_PTL   = R_PTL*fup/(1 + ((R_PTL-1)*fup))         # [-] proximal tubule lumen
       fu_Lic   = R_L_ec*fup/(1 + ((R_L_ec-1)*fup))       # [-] liver intracellular space
      
      
       ### Partition coefficients
       
       PI       = 1
       PK       = 2
       PL       = 3
       PA       = 4
       PR       = 5


     ## BIOKINETIC PARAMETERS
   
       ### Uptake from the gastro-intestinal duct 
     
       Papp_SI          = 7.31 * 1e-6                            # [cm/s] 7.31 ± 0.43, Janssen et al. 2024 http://dx.doi.org/10.1007/s00204-024-03851-x, epiIntestinal
       Vmax_OATP2B1c    = 0.001493                               # [umol/min/mg protein] 1493 ± 543 pmol/min/mg protein; Lin et al. 2023 http://dx.doi.org/10.1021/acs.est.2c05642 (pmol -> umol)
       Km_OATP2B1c      = 148.68                                 # [umol/L] 148.68 ± 132.89 uM, Lin et al. 2023
       REF_OATP2B1      = 1.6/0.812                              # [-] relative expression factor OATP2B1, calculated from: OATP2B1_vivo/OATP2B1_vitro (pmol/mg membrane protein / pmol/mg membrane protein); Lin et al. 2023 http://dx.doi.org/10.1021/acs.est.2c05642 tables7 and s6, ref23
       mgOATP_mgI       = 0.13                                   # [mg protein/mg intestine] Utsey et al. 2020 http://dx.doi.org/10.1124/dmd.120.090498
       SF_OATP2B1       = mgOATP_mgI * REF_OATP2B1 * 1e6         # [-] scaling mg liver * 1e6 -> kg liver
     
       CL_IL            = (Papp_SI*SA_SI*1e-3)*60*60*24          # [L/d] Intestinal lumen to intestinal tissue (calculations: cm/s -> L/s /1000 -> L/d *60*60*24)
       VmaxOATP2B1      = Vmax_OATP2B1c*MW*60*24*SF_OATP2B1*VIL  # [ug/d]
       Km_OATP2B1       = Km_OATP2B1c*MW                         # [ug/L] converting uM -> ug/L
      
     
       ### Uptake to the liver
     
       Vmax_OATP1B1c   = 0.002305                                # [umol/min/mg protein] 2305 ± 295 pmol/min/mg protein, Lin et al. 2023 (pmol -> umol)
       Km_OATP1B1c     = 52.65                                   # [umol/L] 52.65 ± 23.28 uM, Lin et al. 2023
       Vmax_OATP1B3c   = 0.002694                                # [umol/min/mg protein] 2694 ± 470 pmol/min/mg protein, Lin et al. 2023 (pmol -> umol)
       Km_OATP1B3c     = 91.61                                   # [umol/L] 91.61 ± 47.70 uM, Lin et al. 2023
       REF_OATP1B1     = 2/0.120                                 # [-] relative expression factor OATP1B1, calculated from: OATP1B1_vivo / OATP1B1_vitro  (pmol/mg membrane protein/pmol/mg membrane protein); Lin et al. 2023 http://dx.doi.org/10.1021/acs.est.2c05642 tables7 and s6, ref23
       REF_OATP1B3     = 1/0.719                                 # [-] relative expression factor OATP1B3, calculated from: OATP1B3_vivo / OATP1B3_vitro  (pmol/mg membrane protein/pmol/mg membrane protein); Lin et al. 2023 http://dx.doi.org/10.1021/acs.est.2c05642 tables7 and s6, ref23
       mgOATP_mgL      = 0.18                                    # [mg protein/mg liver] Utsey et al. 2020 http://dx.doi.org/10.1124/dmd.120.090498
       SF_OATP1B1      = mgOATP_mgL * REF_OATP1B1 * 1e6          # [-] scaling mg liver * 1e6 -> kg liver
       SF_OATP1B3      = mgOATP_mgL * REF_OATP1B3 * 1e6          # [-] scaling mg liver * 1e6 -> kg liver
     
       Vmax_OATP1B1    = Vmax_OATP1B1c*MW*60*24*SF_OATP1B1*VL_ec # [ug/d]
       Km_OATP1B1      = Km_OATP1B1c*MW                          # [ug/L] (uM -> [ug/L])
       Vmax_OATP1B3    = Vmax_OATP1B3c*MW*60*24*SF_OATP1B3*VL_ec # [ug/d]
       Km_OATP1B3      = Km_OATP1B3c*MW     
     
     
       ### Biliary clearance
     
       Vmax_BSEPc      = 7                                       # [umol/min/mg BSEP] averAge active transport of bile acids, assuming that the maximum velocity of PFOA transport by BSEP corresponds to that of bile acids ; de Bruijn et al. 2024 https://doi.org/10.14573/altex.2302011 
       Km_BSEPc        = 16.4                                    # [umol/L] averAge affinity constant of bile acids to BSEP, following the above assumption ; de Bruijn et al. 2024 https://doi.org/10.14573/altex.2302011
       mgBSEP_HC       = 0.839 * 140000 * 1e-9                   # [mg BSEP/1e6 hepatocytes] (0.839 pmole BSEP/1e6 hepatocytes (amound of BSEP per hepatocyte) * 140000 g/mole (MW BSEP) -> pg * 1e-9 -> mg) de Bruijn et al. 2024 https://doi.org/10.14573/altex.2302011]
       HC_GL           = 99                                      # [1e6 hepatocytes] number of hepatocytes in the liver ; de Bruijn et al. 2024 https://doi.org/10.14573/altex.2302011
       SF_BSEP         = mgBSEP_HC * HC_GL * 1e3                 # [-] scaling factor for BSEP mediated hepatic efflux for GCA and GCDC ; de Bruijn et al. 2024 https://doi.org/10.14573/altex.2302011
     
       Vmax_BSEP       = Vmax_BSEPc*MW*60*24*SF_BSEP*VL_ic       # [ug/d]
       Km_BSEP         = Km_BSEPc*MW                             # [ug/L] (uM -> [ug/L])
      
     
       ### Renal Clearance
       
       Vmax_OAT4c      = 4.5 *1e-3                               # [umol/min/mg protein] Louisse et al. 2024 doi.org/10.1016/j.tox.2024.153961 (nmol -> umol)
       Km_OAT4c        = 47                                      # [ug/L], scaled from uM, Louisse et al. 2024 doi.org/10.1016/j.tox.2024.153961
       REF_OAT4        = 1.9/0.063                               # [-] relative expression factor OAT,  calculated from: OAT4_vivo / OAT4_vitro  (pmol/mg membrane protein/ pmol/mg membrane protein); in vivo: Al-Madjoub et al 2021 (https://doi.org/10.1002/(AP/VP)t.2396), in vitro:; Lin et al. 2023 http://dx.doi.org/10.1021/acs.est.2c05642 tables5
       mgOAT_mgK       = 0.17                                    # [mg protein/mg kidney] Utsey et al. 2020 http://dx.doi.org/10.1124/dmd.120.090498
       SF_OAT          = mgOAT_mgK * REF_OAT4 * 1e6              # [-] scaling mg kidney * 1e6 -> kg kidney
     
       Vmax_OAT4       = Vmax_OAT4c*MW*60*24*SF_OAT*VPT          # [ug/d] (umol -> ug, min -> d)
       Km_OAT4         = Km_OAT4c*MW                             # [ug/L] (uM -> [ug/L])
     
      
       ### Clearance via menstruation
       CL_menses       = 0                                       # [L/d] plasma menstrual loss
 

# COMPARTMENTS

     compartment P          := VP              #   compartment of Plasma [L]
     compartment IL         := VIL             #   compartment of Intestinal lumen [L]
     compartment I          := VI              #   compartment of Intestinal tissue [L]
     compartment L_ec       := VL_ec           #   compartment of Liver extracellular space [L]
     compartment L_ic       := VL_ic           #   compartment of Liver intracellular space [L]
     compartment PTT        := VPTT            #   compartment of Kidney proximal tubule tissue [L]
     compartment PTL        := VPTL            #   compartment of Kidney proximal tubule lumen [L]
     compartment RKT        := VRKT            #   compartment of Kidney rest of kidney tissue [L]
     compartment RKL        := VRKL            #   compartment of Kidney rest of kidney lumen [L]
     compartment A          := VA              #   compartment of Adipose [L]
     compartment R          := VR              #   compartment of Rest [L]
     compartment Fe          = 1               #   compartment of storage of Feces [ug]
     compartment Ur          = 1               #   compartment of storage of Urine [ug]
     compartment Mp          = 1               #   compartment of storage of Menstrual plasma [ug]


# SPECIES

     substanceOnly species AP        in P      # Quantity of chemical in Plasma [ug]
     substanceOnly species AIL       in IL     # Quantity of chemical in Intestinal lumen [ug]
     substanceOnly species AI        in I      # Quantity of chemical in Intestinal tissue [ug]
     substanceOnly species AL_ec     in L_ec   # Quantity of chemical in Liver extracellular space [ug]
     substanceOnly species AL_ic     in L_ic   # Quantity of chemical in Liver intracellular space [ug]
     substanceOnly species APTT      in PTT    # Quantity of chemical in Kidney proximal tubule tissue [ug]
     substanceOnly species APTL      in PTL    # Quantity of chemical in Kidney proximal tubule lumen [ug]
     substanceOnly species ARKT      in RKT    # Quantity of chemcial in Kidney rest of kidney tissue [ug]
     substanceOnly species ARKL      in RKL    # Quantity of chemical in Kidney rest of kidney lumen [ug]
     substanceOnly species AA        in A      # Quantity of chemical in Adipose [ug]
     substanceOnly species AR        in R      # Quantity of chemical in Rest [ug]
     substanceOnly species AFe       in Fe     # Cumulative quantity of chemical in Feces [ug]
     substanceOnly species AUr       in Ur     # Cumulative quantity of chemical in Urine [ug]
     substanceOnly species AMp       in Mp     # Cumulative quantity of chemical in Menstrual plasma [ug]


# INITIAL AMOUNTS

    AP     = 0                                 # Initial amount in A [ug]
    AIL    = 0                                 # Initial amount in IL [ug]
    AI     = 0                                 # Initial amount in I [ug]
    AL_ec  = 0                                 # Initial amount in L_ec [ug]
    AL_ic  = 0                                 # Initial amount in L_ic [ug]
    APTT   = 0                                 # Initial amount in PTT [ug]
    APTL   = 0                                 # Initial amount in PTL [ug]
    ARKT   = 0                                 # Initial amount in RKT [ug]
    ARKL   = 0                                 # Initial amount in RKL [ug]
    AA     = 0                                 # Initial amount in A [ug]
    AR     = 0                                 # Initial amount in R [ug]
    AFe    = 0                                 # Initial amount in Fe [ug]
    AUr    = 0                                 # Initial amount in Ur [ug]
    AMp    = 0                                 # Initial amount in Mp [ug]


  

# REACTIONS

    ## DISTRIBUTION
    
    J1_:    AIL    -> AI;       CL_IL*(AIL/VIL) + (VmaxOATP2B1/(Km_OATP2B1 + (AIL/VIL)))*(AIL/VIL)
    J3_:    AL_ic  -> AIL;      (Vmax_BSEP/(Km_BSEP + ((AL_ic/VL_ic)*fu_Lic)))*(AL_ic/VL_ic)*fu_Lic
    
    J4_:    AP     -> AI;       QI*(AP/VP)
    J5_:    AI     -> AL_ec;    QI*(AI/VI/PI)
    
    J6_:    AP     -> AL_ec;    QL*(AP/VP)
    J7_:    AL_ec  -> AP;       (QI + QL)*(AL_ec/VL_ec/PL)
    J8_:    AL_ec  -> AL_ic;    (Vmax_OATP1B1/(Km_OATP1B1 + ((AL_ec/VL_ec)*fup)))*(AL_ec/VL_ec)*fup + (Vmax_OATP1B3/(Km_OATP1B3 + ((AL_ec/VL_ec)*fup)))*(AL_ec/VL_ec)*fup  
    
    J9_:    AP     -> APTT;     QK*(AP/VP)
    J10_:   APTT   -> ARKT;     QK*(APTT/VPTT)
    J11_:   ARKT   -> AP;       QK*(ARKT/VRKT/PK)
    J12_:   AP     -> APTL;     fup*GFR*(AP/VP)
    J13_:   APTL   -> ARKL;     QT*(APTL/VPTL)
    J14_:   APTL   -> APTT;     (Vmax_OAT4/(Km_OAT4+((APTL/VPTL)*fu_PTL)))*(APTL/VPTL)*fu_PTL
    J15_:   AP     -> AA;       QA*(AP/VP)
    J16_:   AA     -> AP;       QA*(AA/VA/PA) 
    J17_:   AP     -> AR;       QR*(AP/VP)
    J18_:   AR     -> AP;       QR*(AR/VR/PR)
    
    ## ELIMINATION
    
    J19_:   AIL    -> AFe;      tco*AIL
    J20_:   ARKL   -> AUr;      QUr*(ARKL/VRKL)
    J21_:   AP     -> AMp;      CL_menses*(AP/VP)



end